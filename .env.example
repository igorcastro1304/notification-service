# Postgres
DATABASE_URL=postgres://notification_service:notification_service@localhost:55432/notification_service?sslmode=disable

# Redpanda / Kafka (porta externa, acessada do seu PC)
KAFKA_BROKERS=localhost:19092
KAFKA_CONSUMER_GROUP=notification-service-workers

# Redis
REDIS_ADDR=localhost:6379

# API
HTTP_ADDR=:8080

# Logs: debug | info | warn | error
LOG_LEVEL=info
